[Unit]
Description=Update Uralsky Kontekst from its GitHub production branch
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=context-deploy
Group=context-deploy
WorkingDirectory=/opt/uralsky-kontekst/repo
ExecStart=/usr/local/bin/uralsky-kontekst-update
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/uralsky-kontekst
UMask=0022
